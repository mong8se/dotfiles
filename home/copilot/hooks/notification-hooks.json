{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "kitten notify --icon=info --app-name='Copilot' 'Copilot: Agent Stopped' 'The agent has stopped running.'",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "jq --raw-output0 '.error | [\"Copilot: \" + .name,.message] | map( .[0:399])[]' | xargs -0 kitten notify --icon=error --app-name='Copilot'",
        "timeoutSec": 5
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "jq --raw-output0 '[\"Copilot: \" + .title,.message] | map( .[0:399] )[]' | xargs -0 kitten notify --icon=info --app-name='Copilot'",
        "timeoutSec": 5
      }
    ]
  }
}
